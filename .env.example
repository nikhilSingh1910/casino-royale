# Copy to .env for local dev. Parsed and validated at boot by src/shared/config (C2.1).
# A missing or malformed value crashes the process on start — never three hours into a job.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (used from M1 onward — the chip ledger + all state)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/casino_royale
